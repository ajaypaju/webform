APP_NAME=Webform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# api | ingest — selects which route file bootstrap/app.php loads. compose.yaml sets it per service.
APP_ROLE=api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OCTANE_SERVER=frankenphp

# I13: HMAC key for form render tokens; `make up` fills it if empty. Not APP_KEY.
RENDER_TOKEN_KEY=
# Pseudonymises visitor IPs in submission meta; `make up` fills it if empty.
IP_HASH_KEY=
# Ingest only: proxies whose X-Forwarded-For is believed, comma-separated IPs/CIDRs, e.g. 10.0.0.0/8,fd00::/8.
# Empty = trust nobody (socket IP is the visitor). '*' is safe only when a proxy that always overwrites
# X-Forwarded-For is the sole path in; otherwise anyone can pick their own rate-limit bucket.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=webform
# Local artisan runs as the owner; compose gives api/ingest/consumer their own role (I11).
DB_USERNAME=webform_owner
DB_PASSWORD=owner-dev
DB_OWNER_PASSWORD=owner-dev
DB_API_PASSWORD=api-dev
DB_INGEST_PASSWORD=ingest-dev
DB_WRITER_PASSWORD=writer-dev

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC_SUBMISSIONS=submissions
KAFKA_TOPIC_SUBMISSIONS_DLQ=submissions.dlq
KAFKA_MESSAGE_TIMEOUT_MS=5000
KAFKA_LINGER_MS=5
KAFKA_CONSUMER_GROUP=submissions-consumer
